<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalizar Widget"
            android:textColor="#FBBF24"
            android:textSize="24sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prévia ao vivo — ajuste e toque em OK"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- ===== PRÉVIA AO VIVO DO WIDGET (padrão Fossify) ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/preview_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/widget_bg_dark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/widget_icon_badge">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@mipmap/ic_launcher" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LUZ DIÁRIA"
                        android:textColor="#FBBF24"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="0.16"
                        android:paddingStart="9dp"
                        android:paddingLeft="9dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/preview_verse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Porque Deus amou o mundo de tal maneira que deu o seu Filho unigênito, para que todo aquele que nele crê não pereça, mas tenha a vida eterna."
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/preview_ref"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="João 3:16"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ===== COR DE FUNDO (padrão Fossify: quadrado de cor + seekbar) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/btn_bg_color"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/widget_bg_dark" />

            <SeekBar
                android:id="@+id/seek_bg_alpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"
                android:progressTint="#FBBF24"
                android:thumbTint="#FBBF24"
                android:splitTrack="false" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toque na cor para alternar • Deslize para a transparência do fundo"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- ===== COR DO TEXTO (padrão Fossify) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btn_text_color"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/widget_config_color_swatch" />

            <TextView
                android:id="@+id/txt_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branco"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== TAMANHO DO TEXTO (slider, padrão Fossify) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/txt_size_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamanho do texto: 16"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <SeekBar
                android:id="@+id/seek_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="6"
                android:progressTint="#FBBF24"
                android:thumbTint="#FBBF24"
                android:splitTrack="false" />
        </LinearLayout>

        <!-- ===== BOTÃO OK (padrão Fossify) ===== -->
        <Button
            android:id="@+id/btn_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OK"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/widget_config_done"
            android:paddingTop="15dp"
            android:paddingBottom="15dp" />
    </LinearLayout>
</ScrollView>
