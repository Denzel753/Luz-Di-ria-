<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================================
         PERMISSÕES PARA AS TELAS NATIVAS (window.Android)
         ============================================================ -->

    <!-- 1. requestBatteryOptimization()
         Necessária para abrir ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         e pedir que o app fique imune à economia de bateria. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 2. (removido) requestOverlayPermission() — o pop-up gigante usa
         Activity + FullScreenIntent (padrão AMdroid/AlarmClock), NÃO usa
         sobreposição. SYSTEM_ALERT_WINDOW foi removido do app. -->

    <!-- 3. requestExactAlarmPermission() — Android 12+ (API 31+)
         Necessária para ACTION_REQUEST_SCHEDULE_EXACT_ALARM
         (alarmes exatos / notificações pontuais). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 4. (removido) requestAccessibilityPermission() — o app não usa
         serviço de acessibilidade. VerseAccessibilityService removido. -->

    <!-- 5. openNotificationSettings()
         Não exige permissão declarada para ABRIR a tela; porém, para o app
         PODER enviar notificações no Android 13+ (API 33), é obrigatório: -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permissões padrão do app (rede e alarme) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
